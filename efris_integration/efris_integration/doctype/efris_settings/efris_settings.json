    "taxpayer_id"
  ],

  "fields": [

    { "fieldname": "tab_connection", "fieldtype": "Tab Break", "label": "Connection" },

    {
      "fieldname": "api_url",
      "fieldtype": "Data",
      "label": "URL",
      "reqd": 1,
      "description": "https://efristest.ura.go.ug/efrisws/ws/taapp/getInformation"
    },
    {
      "fieldname": "public_key_path",
      "fieldtype": "Data",
      "label": "EFRIS Public Key Path",
      "description": "Absolute server path to PublicKey.txt  (U_OT_EPK)"
    },
    {
      "fieldname": "session_key_path",
      "fieldtype": "Data",
      "label": "Session Key Path",
      "description": "Absolute server path to SessionAESKey.txt  (U_OT_SAK)"
    },
    {
      "fieldname": "private_key_path",
      "fieldtype": "Data",
      "label": "Private Key Path",
      "description": "Absolute server path to PrivateKey.txt  (U_OT_PK)"
    },
    { "fieldname": "col_conn", "fieldtype": "Column Break" },
    {
      "fieldname": "device_no",
      "fieldtype": "Data",
      "label": "Device No",
      "reqd": 1,
      "description": "U_OT_DevNo"
    },
    {
      "fieldname": "app_id",
      "fieldtype": "Data",
      "label": "App Id",
      "reqd": 1,
      "description": "U_OT_AppId"
    },
    {
      "fieldname": "efris_username",
      "fieldtype": "Data",
      "label": "User Name",
      "reqd": 1,
      "description": "U_OT_UserName"
    },
    {
      "fieldname": "api_version",
      "fieldtype": "Data",
      "label": "Version",
      "default": "1.1.20191201",
      "description": "U_OT_Version"
    },

    { "fieldname": "tab_settings", "fieldtype": "Tab Break", "label": "Settings" },

    { "fieldname": "use_t127",            "fieldtype": "Check", "label": "USE T127  On AR Invoice",   "description": "U_OT_UseT127" },
    { "fieldname": "gross_on_sales_order","fieldtype": "Check", "label": "Gross On Sales Order",      "description": "U_OT_GrosTot" },
    { "fieldname": "gross_on_delivery",   "fieldtype": "Check", "label": "Gross On Delivery",         "description": "U_OT_GrosDL"  },
    { "fieldname": "gross_on_ar_invoice", "fieldtype": "Check", "label": "Gross On AR Invoice",       "default": "1", "description": "U_OT_GrosAR"  },
    { "fieldname": "col_sett1", "fieldtype": "Column Break" },
    { "fieldname": "beverage_industry",   "fieldtype": "Check", "label": "Beverage Industry",         "description": "U_OT_BEVIND"  },
    { "fieldname": "price_on_sales_order","fieldtype": "Check", "label": "Price On Sales Order",      "description": "U_OT_UPrcSO"  },
    { "fieldname": "price_on_delivery",   "fieldtype": "Check", "label": "Price On Delivery",         "default": "1", "description": "U_OT_UPrcDL"  },
    { "fieldname": "price_on_ar_invoice", "fieldtype": "Check", "label": "Price On AR Invoice",       "default": "1", "description": "U_OT_UPrcAR"  },
    { "fieldname": "col_sett2", "fieldtype": "Column Break" },
    { "fieldname": "multi_branch",        "fieldtype": "Check", "label": "Enable Multi-Branch",       "description": "U_OT_MULTIBRNCH" },
    { "fieldname": "stock_transfer",      "fieldtype": "Check", "label": "Stock Transfer",            "description": "U_OT_CSTCTSF"   },
    { "fieldname": "issue_from_production",   "fieldtype": "Check", "label": "Issue From Production",   "description": "U_OT_IFP" },
    { "fieldname": "receipt_from_production", "fieldtype": "Check", "label": "Receipt From Production", "description": "U_OT_RFP" },
    { "fieldname": "col_sett3", "fieldtype": "Column Break" },
    { "fieldname": "alcohol_industry",    "fieldtype": "Check", "label": "Alcohol Industry",          "description": "U_OT_ALCOHOL" },

    {
      "fieldname": "tab_company",
      "fieldtype": "Tab Break",
      "label": "Company Info",
      "description": "In SAP B1 these are read from OADM (company master). Enter them here once."
    },
    {
      "fieldname": "tin",
      "fieldtype": "Data",
      "label": "TIN",
      "reqd": 1,
      "description": "Uganda Revenue Authority TIN  (OADM.DdctOffice)"
    },
    {
      "fieldname": "taxpayer_id",
      "fieldtype": "Data",
      "label": "Taxpayer ID",
      "reqd": 1,
      "description": "EFRIS Taxpayer ID  (OADM.TaxIdNum2)"
    }
  ],

  "in_create": 0,
  "module": "EFRIS Integration",
  "name": "EFRIS Settings",
  "permissions": [
    {
      "create": 1,
